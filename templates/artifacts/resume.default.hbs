{{!-- Default Resume Template --}}
{{#if name}}
<div style="text-align: center; margin-bottom: 20px;">
  <h1 style="margin: 0; font-size: 28px;">{{name}}</h1>
  {{#if contact}}
  <p style="margin: 5px 0; font-size: 12px;">
    {{#if contact.email}}{{contact.email}}{{#if contact.phone}} | {{/if}}{{/if}}
    {{#if contact.phone}}{{contact.phone}}{{#if contact.location}} | {{/if}}{{/if}}
    {{#if contact.location}}{{contact.location}}{{/if}}
  </p>
  {{/if}}
</div>
{{/if}}

{{#if summary}}
<div style="margin-bottom: 20px;">
  <h2 style="font-size: 14px; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 5px; margin: 0 0 10px 0;">PROFESSIONAL SUMMARY</h2>
  <p style="margin: 0; font-size: 11px; line-height: 1.6;">{{summary}}</p>
</div>
{{/if}}

{{#if experience}}
<div style="margin-bottom: 20px;">
  <h2 style="font-size: 14px; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 5px; margin: 0 0 10px 0;">EXPERIENCE</h2>
  {{#each experience}}
  <div style="margin-bottom: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: baseline;">
      <h3 style="margin: 0; font-weight: bold; font-size: 12px;">{{this.title}}</h3>
      {{#if this.start_date}}
      <span style="font-size: 10px; color: #666;">{{formatDate this.start_date}}{{#if this.is_current}} - Present{{else}}{{#if this.end_date}} - {{formatDate this.end_date}}{{/if}}{{/if}}</span>
      {{/if}}
    </div>
    <p style="margin: 2px 0; font-style: italic; font-size: 11px;">{{this.company}}</p>
    {{#if this.description}}
    <p style="margin: 5px 0; font-size: 11px; line-height: 1.5;">{{this.description}}</p>
    {{/if}}
    {{#if this.achievements}}
    <ul style="margin: 5px 0 0 20px; padding: 0; font-size: 11px; line-height: 1.5;">
      {{#each this.achievements}}
      <li style="margin-bottom: 3px;">{{this}}</li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}

{{#if skills}}
<div style="margin-bottom: 20px;">
  <h2 style="font-size: 14px; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 5px; margin: 0 0 10px 0;">SKILLS</h2>
  <p style="margin: 0; font-size: 11px; line-height: 1.6;">
    {{#each skills}}
      {{#if @index}}, {{/if}}{{this.name}}
    {{/each}}
  </p>
</div>
{{/if}}

{{#if education}}
<div style="margin-bottom: 20px;">
  <h2 style="font-size: 14px; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 5px; margin: 0 0 10px 0;">EDUCATION</h2>
  {{#each education}}
  <div style="margin-bottom: 10px;">
    <div style="display: flex; justify-content: space-between;">
      <h3 style="margin: 0; font-weight: bold; font-size: 12px;">{{this.degree}}</h3>
      {{#if this.graduation_date}}
      <span style="font-size: 10px; color: #666;">{{formatDate this.graduation_date}}</span>
      {{/if}}
    </div>
    <p style="margin: 2px 0; font-size: 11px;">{{this.field_of_study}}</p>
    <p style="margin: 2px 0; font-style: italic; font-size: 11px;">{{this.institution}}</p>
    {{#if this.gpa}}
    <p style="margin: 2px 0; font-size: 10px; color: #666;">GPA: {{this.gpa}}</p>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}

{{#if certifications}}
<div style="margin-bottom: 20px;">
  <h2 style="font-size: 14px; font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 5px; margin: 0 0 10px 0;">CERTIFICATIONS</h2>
  {{#each certifications}}
  <div style="margin-bottom: 5px; font-size: 11px;">
    <strong>{{this.name}}</strong> - {{this.issuer}}
    {{#if this.issue_date}}<span style="color: #666;">({{formatDate this.issue_date}})</span>{{/if}}
  </div>
  {{/each}}
</div>
{{/if}}
